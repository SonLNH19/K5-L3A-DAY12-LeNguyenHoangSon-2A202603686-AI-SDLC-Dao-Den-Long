{
  "name": "dao-den-long",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Đảo Đèn Lồng — Bình minh, bản phát hành v1.0.0",
  "scripts": {
    "start": "node scripts/serve.mjs",
    "build": "node scripts/setup-browser.mjs && node scripts/build.mjs",
    "headless": "node src/headless.mjs",
    "test": "node --test tests/*.test.mjs",
    "verify": "node scripts/verify.mjs",
    "proof": "node scripts/proof.mjs",
    "test:browser": "playwright test",
    "bench": "node scripts/bench.mjs",
    "soak": "node --jitless --expose-gc --max-semi-space-size=1 scripts/soak.mjs",
    "release:pack": "node scripts/package-release.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "license": "MIT",
  "dependencies": {
    "three": "0.187.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1"
  }
}
